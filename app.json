{
  "expo": {
    "name": "ProZone",
    "slug": "Zone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/prozone-icon.png",
    "scheme": "zone",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/prozone-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/prozone-android-foreground.png",
        "monochromeImage": "./assets/images/prozone-android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.Prozone.app"
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/prozone-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/prozone-logo.png",
          "imageWidth": 250
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ProZone to select photos for property listings."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "399a8160-e926-4864-a6f7-3fc07b082d8d"
      },
      "EXPO_PUBLIC_SUPABASE_URL": "https://pmckyukeapfwbysmvlhr.supabase.co",
      "EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_SYtpzi73s3_o5VxVI7MUew_EsyQJG10"
    }
  }
}